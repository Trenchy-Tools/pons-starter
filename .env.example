# The TrenchyTools API. Get a key with one call (no account):  curl "https://api.trenchy.tools/api/create-api-key?label=pons-starter"
TRENCHY_API_URL=https://api.trenchy.tools
TRENCHY_API_KEY=

# Where your wallet files live. Leave empty for ~/Desktop/trenchytools-wallets (or ~/trenchytools-wallets without a Desktop).
# The folder is shared with the pump.fun starter; this app only reads files with "chain": "rh".
WALLET_BACKUP_DIR=

PORT=3000
